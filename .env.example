# Project Métis - Environment Configuration
# Copy this file to .env and modify as needed

# Application
METIS_APP_NAME="Project Métis"
METIS_APP_VERSION="0.1.0"
METIS_ENVIRONMENT=development
METIS_DEBUG=true

# Database
METIS_DB_HOST=localhost
METIS_DB_PORT=5432
METIS_DB_USERNAME=metis
METIS_DB_PASSWORD=metis_dev_password
METIS_DB_NAME=metis
METIS_DB_POOL_SIZE=10
METIS_DB_MAX_OVERFLOW=20
METIS_DB_POOL_TIMEOUT=30
METIS_DB_POOL_RECYCLE=3600
METIS_DB_ECHO=false

# API
METIS_API_HOST=0.0.0.0
METIS_API_PORT=8000
METIS_API_WORKERS=1
METIS_API_RELOAD=true
METIS_API_LOG_LEVEL=debug
METIS_API_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
METIS_API_PREFIX=/api/v1

# Simulation
METIS_SIM_DEFAULT_PATHS=10000
METIS_SIM_DEFAULT_HORIZON_BARS=16
METIS_SIM_DEFAULT_CONFIDENCE_LEVELS=[0.95, 0.99]
METIS_SIM_DEFAULT_SEED=42
METIS_SIM_DEFAULT_DT=0.010416666666666666

# Market Data
METIS_MD_DEFAULT_PROVIDER=synthetic
METIS_MD_DEFAULT_FREQUENCY=15min
METIS_MD_SUPPORTED_FREQUENCIES=["5min", "15min", "1h"]
METIS_MD_DEFAULT_SYMBOLS=["EURUSD", "GBPUSD", "USDJPY", "AUDUSD", "USDCHF", "USDCAD", "NZDUSD"]
METIS_MD_VALIDATION_ENABLED=true
METIS_MD_MAX_SPREAD_BPS=50
METIS_MD_MAX_STALE_MINUTES=60

# Logging
METIS_LOG_LEVEL=INFO
METIS_LOG_JSON_FORMAT=true
METIS_LOG_INCLUDE_TRACE_ID=true